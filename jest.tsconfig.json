{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "target": "es2020",
    "jsx": "react",
    "esModuleInterop": true,
    "downlevelIteration": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true
  },
  "references": [
    {
      "path": "./packages/podlite-to-jsx"
    },
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/podlite-schema"
    }
  ]
}
