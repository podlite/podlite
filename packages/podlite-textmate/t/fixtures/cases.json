   "expect": [
    {
     "find": "id",
     "nth": 0,
     "hasNot": "entity.other.attribute-name"
    },
    {
     "find": "=",
     "nth": 1,
     "hasNot": "punctuation.definition.continuation"
    }
   ]
  },
