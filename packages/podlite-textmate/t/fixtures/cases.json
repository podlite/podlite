{
 "quickstart": "quickstart-81-93.podlite",
 "cases": [
  {
   "id": "table-opener",
   "code": "=begin table :caption('X')\nA | B\n=end table\n",
   "expect": [
    {
     "find": "=begin",
     "nth": 0,
     "has": "keyword.control.directive"
    },
    {
     "find": "table",
     "nth": 0,
     "has": "entity.name.tag"
    },
    {
     "find": "caption",
     "nth": 0,
     "has": "entity.other.attribute-name"
    },
    {
     "find": "('X')",
     "nth": 0,
     "has": "string.quoted.single"
    }
   ]
  },
  {
   "id": "attribute-forms",
   "code": "=for para :!flag :n(3) :q('a b') :w<x> :l[1,2] :h{a=>1} :s｢t｣ :k'str' :d\"str\"\ntext\n",
   "expect": [
    {
     "find": "!",
     "nth": 0,
     "has": "keyword.operator.negation"
    },
    {
     "find": "(3)",
     "nth": 0,
     "has": "constant.numeric"
    },
    {
     "find": "('a b')",
     "nth": 0,
     "has": "string.quoted.single"
    },
    {
     "find": "<x>",
     "nth": 0,
     "has": "string.unquoted"
    },
    {
     "find": "[1,2]",
     "nth": 0,
     "has": "meta.structure.list"
    },
    {
     "find": "{a=>1}",
     "nth": 0,
     "has": "meta.structure.dictionary"
    },
    {
     "find": "｢t｣",
     "nth": 0,
     "has": "string.quoted.other"
    },
    {
     "find": "'str'",
     "nth": 0,
     "has": "string.quoted.single"
    },
    {
     "find": "\"str\"",
     "nth": 0,
     "has": "string.quoted.double"
    }
   ]
  },
  {
   "id": "continuation",
   "code": "=for para\n=   :id<x>\ntext\n",
   "expect": [
    {
     "find": "=",
     "nth": 1,
     "has": "punctuation.definition.continuation"
    },
    {
     "find": "id",
     "nth": 0,
     "has": "entity.other.attribute-name"
    }
   ]
  },
  {
